# Both are optional. Without them the serverless endpoints answer 503 and the
# browser's own reader chain handles link ingestion exactly as it did before
# there was a server — which is why `npm run dev` needs no secrets at all.

# Any Postgres connection string; the pooled one if your host offers a choice.
# Apply db/schema.sql to it once.
POSTGRES_URL=

# Rented residential proxy, for the retailers that refuse data-centre traffic.
# Without it the endpoint still caches and still reads the shops that answer a
# plain fetch — it just has no second attempt for the ones that do not.
SCRAPINGBEE_API_KEY=

# Optional ceiling on paid calls per day. Defaults to 200.
DAILY_SCRAPE_CAP=
